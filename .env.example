# WHATSFLUX_EMAIL: E-mail da conta WhatsFlux (armazenado com segurança no servidor)
WHATSFLUX_EMAIL=""

# WHATSFLUX_SENHA: Senha da conta WhatsFlux (armazenado com segurança no servidor)
WHATSFLUX_SENHA=""

# WHATSFLUX_QUEUE_ID: ID da fila a ser monitorada no WhatsFlux (padrão: 18)
WHATSFLUX_QUEUE_ID="18"

# ADMIN_PASSWORD: Senha de proteção para alterar credenciais no painel (opcional)
ADMIN_PASSWORD=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
